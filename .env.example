# Node
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://next:next@localhost:5432/next?schema=public
POSTGRES_USER=next
POSTGRES_PASSWORD=next
POSTGRES_DB=next

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=replace_me_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_me_with_another_random_value
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=14d

# Google OAuth (React Native — idToken 검증용)
GOOGLE_CLIENT_ID=

# AWS S3 / MinIO
AWS_REGION=ap-northeast-2
S3_BUCKET=travelblog-dev
S3_PRESIGNED_EXPIRES=300
S3_MAX_PHOTO_BYTES=20971520
S3_MAX_THUMB_BYTES=512000
# 로컬 MinIO 사용 시 아래 두 줄 언코멘트
# S3_ENDPOINT=http://localhost:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin

# GPU Server (leave defaults for local dev; override in production)
GPU_SERVER_URL=http://localhost:8001
GPU_INTERNAL_TOKEN=dev-internal-token
JOB_STALL_TIMEOUT_MS=300000
CALLBACK_BASE_URL=http://localhost:3000

# Production deployment
PUBLIC_DOMAIN=3.38.73.152.nip.io
SENTRY_DSN=
