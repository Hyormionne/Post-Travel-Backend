{
  "moduleFileExtensions": ["ts", "js", "json", "mjs"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "<rootDir>/patch-import-meta.js",
    "^.+\\.mjs$": "<rootDir>/patch-import-meta.js"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^generated/(.*)$": "<rootDir>/../generated/$1"
  },
  "transformIgnorePatterns": [],
  "resolver": "<rootDir>/jest-resolver.js",
  "setupFiles": ["<rootDir>/setup-dynamic-import.js"],
  "forceExit": true
}
